{
	"name": "portal",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve --open --port 4400",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint",
		"lint:fix": "ng lint --fix",
		"icons": "node scripts/generate-icons.mjs",
		"icons:check": "node scripts/generate-icons.mjs --check",
		"typecheck": "ng build --configuration development --output-path=.angular/typecheck",
		"format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{js,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{js,json}\""
	},
	"private": true,
	"packageManager": "npm@11.12.1",
	"dependencies": {
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/core": "^21.2.0",
		"@angular/platform-browser": "^21.2.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^21.2.6",
		"@angular/cli": "^21.2.6",
		"@angular/compiler-cli": "^21.2.0",
		"@eslint/js": "^9.39.5",
		"angular-eslint": "^21.4.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^28.0.0",
		"prettier": "^3.8.1",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.0.8"
	}
}
